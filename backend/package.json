{
  "name": "altroz-hrms-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "migrate": "sequelize-cli db:migrate --config src/config/sequelize-cli.cjs --migrations-path src/migrations",
    "seed": "sequelize-cli db:seed:all --config src/config/sequelize-cli.cjs --seeders-path src/seeders",
    "seed:undo": "sequelize-cli db:seed:undo:all --config src/config/sequelize-cli.cjs --seeders-path src/seeders",
    "db:create": "sequelize-cli db:create --config src/config/sequelize-cli.cjs",
    "db:drop": "sequelize-cli db:drop --config src/config/sequelize-cli.cjs",
    "db:reset": "npm run db:drop && npm run db:create && npm run migrate && npm run seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.5",
    "sanitize-html": "^2.13.1",
    "sequelize": "^6.37.5",
    "validator": "^13.12.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "sequelize-cli": "^6.6.2"
  }
}
