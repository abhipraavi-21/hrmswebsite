# Import your completed values into Hostinger's Environment variables screen.
# Keep the real .env file local; this example contains placeholders only.
NODE_ENV=production
PORT=3000
APP_URL=https://altroztech.com
FRONTEND_URL=https://altroztech.com
ADMIN_URL=https://altroztech.com/admin
TRUST_PROXY_HOPS=1

# Copy the full database names and hostname from Hostinger.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=YOUR_FULL_DATABASE_NAME
DB_USER=YOUR_FULL_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD

JWT_SECRET=YOUR_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=1d

# These credentials are used by the initial seed, not to reset existing accounts.
ADMIN_NAME=Super Admin
ADMIN_EMAIL=YOUR_ADMIN_EMAIL
ADMIN_PASSWORD=YOUR_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS

# For durable media, use a Hostinger-confirmed absolute persistent folder
# outside the deployment directory instead of the development default below.
UPLOAD_DIR=src/uploads
MAX_FILE_SIZE_MB=100

# Public browser configuration; never add secrets to VITE_ variables.
VITE_API_BASE_URL=/api
VITE_ADMIN_APP_URL=/admin
VITE_PUBLIC_SITE_URL=https://altroztech.com
VITE_SITE_URL=https://altroztech.com

# Optional: enter actual credentials in Hostinger to enable payment checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
